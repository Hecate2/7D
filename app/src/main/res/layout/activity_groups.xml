<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="14dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/groups_title"
            android:textColor="@color/paper"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 语言切换：只用「文A」两个字形，不写死具体语言，切换后也不用改图标 -->
        <TextView
            android:id="@+id/langButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_pill"
            android:contentDescription="@string/language"
            android:gravity="center"
            android:minWidth="40dp"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:text="@string/lang_icon"
            android:textColor="@color/paper"
            android:textSize="12sp" />

        <!-- 屏幕常亮开关：纯图标，开=琥珀、关=月灰（与采集页手电筒/对焦键同一套开关语义）。
             常亮是三个页面共用的偏好，入口放在根页面这一处。 -->
        <ImageView
            android:id="@+id/keepOnButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_icon_button"
            android:clickable="true"
            android:contentDescription="@string/groups_keep_on"
            android:focusable="true"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_keep_on" />

        <!-- 存档导出/导入：一对方向相反的托盘图标。走系统文件选择器（SAF），所以不需要任何
             存储权限，落点由用户当场决定（网盘、下载、外置卡都行），app 不指定去处。
             窄屏上这一行已经排了四件东西（语言/常亮/新建），这两个键因此用 6dp 间距而非常亮的 8dp。 -->
        <ImageView
            android:id="@+id/exportStoreButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_icon_button"
            android:clickable="true"
            android:contentDescription="@string/groups_export_data"
            android:focusable="true"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_store_out" />

        <ImageView
            android:id="@+id/importStoreButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_icon_button"
            android:clickable="true"
            android:contentDescription="@string/groups_import_data"
            android:focusable="true"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_store_in" />

        <TextView
            android:id="@+id/newButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:text="@string/groups_new"
            android:textColor="@color/paper"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/groups_subtitle"
        android:textColor="@color/smoke"
        android:textSize="12sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/groupList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="12dp" />
        </ScrollView>

        <TextView
            android:id="@+id/emptyView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:text="@string/groups_empty"
            android:textColor="@color/smoke"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>