<?xml version="1.0" encoding="utf-8"?>
<!-- 导入存档：与 ic_store_out 同一只托盘，箭头反向指向托盘里（下）。几何与线宽都对齐那一只，
     两只并排放在标题栏时能被读成一对相反的操作，而不是两个看不出关系的图标。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:tint="@color/paper"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 托盘：开口朝上的方框轮廓，底角半径 1.8（与 ic_store_out 逐字相同） -->
    <path
        android:pathData="M4.2,13.6 L4.2,18.4 a1.8,1.8 0 0,0 1.8,1.8 L18,20.2 a1.8,1.8 0 0,0 1.8,-1.8
            L19.8,13.6"
        android:strokeColor="@color/paper"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.9" />

    <!-- 箭头：主干从上方落下、箭头尖停在托盘口，指向托盘之内 -->
    <path
        android:pathData="M12,3.4 L12,13.2"
        android:strokeColor="@color/paper"
        android:strokeLineCap="round"
        android:strokeWidth="1.9" />

    <path
        android:pathData="M7.9,9.1 L12,13.2 L16.1,9.1"
        android:strokeColor="@color/paper"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.9" />
</vector>
